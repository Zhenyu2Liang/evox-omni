// AI Banking Agent — Prisma schema (SQLite)
//
// Demo sandbox: all banking data is simulated. SQLite has no native enum type, so every
// enum-like field is stored as a `String` (the allowed values are documented per field).
// Booked money uses signed BigInt minor units (CNY cents).
// Rates and unrounded valuations use canonical decimal TEXT, avoiding SQLite REAL coercion.
// Public JSON amounts are canonical decimal strings. JSON payloads use String columns.
//
// Field notes:
//   - `balance` / `amount` are signed: negative = expense/outflow, positive = income/inflow.
//   - `type`          on Account        = "CHECKING" | "SAVINGS"
//   - `direction`     on Transaction    = "DEBIT" | "CREDIT"
//   - `channel`       on Transaction    = "APP" | "CARD" | "TRANSFER" | "SUBSCRIPTION"
//   - `type`          on Card           = "DEBIT" | "CREDIT" | "VIRTUAL"
//   - `status`        on Card           = "ACTIVE" | "FROZEN" | "LOST" | "PENDING"
//   - `linkedAccountId` on Card         = id of the user's CHECKING account the card spends from (historical reference, no relation)
//   - `status`        on Subscription   = "ACTIVE" | "CANCELLED"
//   - `riskLevel`     on InvestmentProduct = "R1" | "R2" | "R3" | "R4" | "R5"
//   - `status`        on InvestmentHolding = "HOLDING" | "REDEEMED"
//   - `status`        on Budget         = "RESERVED" | "USED" | "RELEASED"
//   - `kind`          on ScheduledTask  = "REMINDER" | "PAYMENT" | "TRANSFER"
//   - `status`        on ScheduledTask  = "SCHEDULED" | "DONE" | "CANCELLED"
//   - `severity`      on SecurityEvent  = "low" | "medium" | "high"
//   - `status`        on AgentSession   = "active" | "closed"
//   - `status`        on PendingAction  = "pending" | "confirmed" | "awaiting_mfa" | "executed" | "failed" | "cancelled" | "needs_reconciliation"
//   - `status`        on MfaChallenge   = "pending" | "verified" | "failed" | "locked"
//   - `status`        on AgentTask/AgentTaskNode = "pending" | "running" | "done" | "failed" | "blocked"

generator client {
  provider = "prisma-client"
  output   = "../lib/db/generated"
}

datasource db {
  provider = "sqlite"
}

model User {
  id          String   @id @default(cuid())
  name        String
  phone       String   @unique
  avatarEmoji String?
  createdAt   DateTime @default(now())

  accounts       Account[]
  cards          Card[]
  contacts       Contact[]
  subscriptions  Subscription[]
  holdings       InvestmentHolding[]
  budgets        Budget[]
  sessions       AgentSession[]
  scheduledTasks ScheduledTask[]
  auditLogs      AuditLog[]
  securityEvents SecurityEvent[]
}

model Account {
  id       String  @id @default(cuid())
  userId   String
  type     String // "CHECKING" | "SAVINGS"
  name     String
  number   String // masked, e.g. "****8821"
  balanceMinor BigInt @map("balance_minor")
  currency String  @default("CNY")

  user         User          @relation(fields: [userId], references: [id])
  transactions Transaction[]

  @@index([userId])
}

model Transaction {
  id             String   @id @default(cuid())
  accountId      String
  userId         String
  amountMinor    BigInt @map("amount_minor") // negative = expense, positive = income
  currency       String   @default("CNY")
  direction      String // "DEBIT" | "CREDIT"
  category       String // 餐饮/出行/购物/娱乐/居住/医疗/订阅/转账/其他
  merchant       String
  channel        String? // "APP" | "CARD" | "TRANSFER" | "SUBSCRIPTION"
  remark         String?
  counterpartyId String? // Contact id (no relation — historical reference only)
  occurredAt     DateTime
  isAnomaly      Boolean  @default(false)
  anomalyReason  String?
  createdAt      DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id])

  @@index([userId, occurredAt])
  @@index([accountId])
}

model Contact {
  id     String  @id @default(cuid())
  userId String
  name   String
  phone  String
  bank   String?
  remark String?

  user User @relation(fields: [userId], references: [id])

  @@index([userId, name])
}

model Card {
  id             String   @id @default(cuid())
  userId         String
  type           String // "DEBIT" | "CREDIT" | "VIRTUAL"
  network        String   @default("UnionPay")
  numberMasked   String
  status         String   @default("ACTIVE") // "ACTIVE" | "FROZEN" | "LOST" | "PENDING"
  creditLimitMinor    BigInt? @map("credit_limit_minor")
  availableLimitMinor BigInt? @map("available_limit_minor")
  monthlyLimitMinor   BigInt? @map("monthly_limit_minor")
  // id of the replacement card (no relation — historical reference only)
  replacedByCardId    String? @map("replaced_by_card_id")
  // id of the user's CHECKING account this card spends from (no relation — historical reference only)
  linkedAccountId     String? @map("linked_account_id")

  user   User        @relation(fields: [userId], references: [id])
  limits CardLimit[]

  @@index([userId])
}

model CardLimit {
  id       String @id @default(cuid())
  cardId   String
  category String // 娱乐/餐饮/购物/出行/其他
  amountMinor BigInt @map("amount_minor")

  card Card @relation(fields: [cardId], references: [id])

  @@index([cardId])
}

// Durable LOCAL simulated card-consumption ledger: ONE row per SUCCESSFUL local card spend.
// `executionKey` is the replay/idempotency identity (NULL = no replay identity) and `resultJson`
// snapshots the original consume result, so a replay reuses the stored result instead of charging again.
model CardConsumption {
  id           String   @id @default(cuid())
  cardId       String
  accountId    String
  userId       String
  amountMinor  BigInt   @map("amount_minor") // positive magnitude of the spend, CNY cents
  currency     String   @default("CNY")
  category     String
  merchant     String
  occurredAt   DateTime
  executionKey String?  @unique            // replay/idempotency identity; NULL = no replay identity
  resultJson   String?                      // JSON text of the original consume result snapshot (for replay)
  createdAt    DateTime @default(now())

  @@index([cardId, occurredAt])
  @@index([userId, occurredAt])
  @@index([accountId])
}

model Subscription {
  id           String   @id @default(cuid())
  userId       String
  name         String
  amountMinor  BigInt @map("amount_minor")
  cycle        String   @default("MONTHLY")
  nextChargeAt DateTime
  status       String   @default("ACTIVE") // "ACTIVE" | "CANCELLED"
  remind       Boolean  @default(false)

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model InvestmentProduct {
  id           String  @id @default(cuid())
  code         String  @unique
  name         String
  riskLevel    String // "R1" | "R2" | "R3" | "R4" | "R5"
  annualYieldRate String @map("annual_yield_rate") // Exact dimensionless ratio; "0.032575" means 3.2575 percent.
  termDays     Int
  minAmountMinor BigInt @map("min_amount_minor")
  description  String?
  // Latest SIMULATED net value per unit: canonical decimal TEXT, at most 4 fractional digits (e.g. "1.0234"). NULL when no net value is published.
  latestNetValuePerUnit String?   @map("latest_net_value_per_unit")
  // Business date (UTC+08:00) the published net value applies to.
  latestNetValueDate    DateTime? @map("latest_net_value_date")

  holdings InvestmentHolding[]
}

model InvestmentHolding {
  id          String   @id @default(cuid())
  userId      String
  productId   String
  principalAmountMinor BigInt @map("principal_amount_minor") // REMAINING cost basis (remaining principal) after partial redemptions.
  estimatedMarketValue String? @map("estimated_market_value") // Exact CNY valuation, before settlement rounding.
  // Current held SHARES: canonical decimal TEXT, at most 6 fractional digits (e.g. "1960.784314"). NULL for a legacy holding whose shares have not been derived yet.
  shares              String?
  // REALIZED profit already booked by redemptions, CNY cents (may be negative). Cumulative profit = realized + unrealized.
  realizedProfitMinor BigInt  @default(0) @map("realized_profit_minor")
  subscribeResult String? // Original SDK purchase outcome, persisted in the purchase transaction.
  boughtAt    DateTime @default(now())
  status      String   @default("HOLDING") // "HOLDING" | "REDEEMED"
  // Redeem execution identity + ORIGINAL result (persisted when the holding closes): a replay with
  // the SAME identity returns the original result without re-crediting; a DISTINCT identity on an
  // already-REDEEMED holding is rejected (never a false success). NULL until redeemed.
  redeemExecutionKey String?
  redeemResult       String? // JSON text of the original redemption result payload
  // JSON text array of purchase records appended each time a purchase aggregates into this holding;
  // record shape is owned by `banking-sdk/investment.ts`. NULL when no history has been recorded.
  purchaseHistory   String?
  // JSON text array of partial-redemption outcome records appended while the holding stays open;
  // record shape is owned by `banking-sdk/investment.ts`. NULL until a partial redemption is recorded.
  redemptionHistory String?
  // Replay key: `<planId>:<nodeId>` so a replayed plan node replays the existing holding
  // instead of duplicating it. Unkeyed fixture/imported holdings have no replay identity.
  idempotencyKey String? @unique

  user    User              @relation(fields: [userId], references: [id])
  product InvestmentProduct @relation(fields: [productId], references: [id])

  @@index([userId])
  @@index([productId])
}

model Budget {
  id        String    @id @default(cuid())
  userId    String
  name      String
  amountMinor BigInt @map("amount_minor")
  purpose   String?
  status    String    @default("RESERVED") // "RESERVED" | "USED" | "RELEASED"
  dueDate   DateTime?
  // Replay identity belongs to a user: another user's identical local key is independent.
  // NULL remains allowed for calls without a replay key.
  idempotencyKey String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, idempotencyKey])
  @@index([userId])
}

model AgentTask {
  id        String   @id @default(cuid())
  runId String?
  parentInvocationId String?
  sessionId String
  userId    String
  goal      String
  status    String   @default("pending")
  // DB-level exactly-once claim for the PLAN executor: the winning resume/retry sets a unique
  // token here; a concurrent executor that cannot claim it must NOT run the plan. NULL = unclaimed.
  executionToken     String?
  executionClaimedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // Monotonic execution GENERATION of this plan; a later workstream bumps it.
  generation Int @default(0)

  nodes AgentTaskNode[]
  manualReviews ManualReview[]

  @@index([sessionId])
  @@unique([runId, parentInvocationId])
}

// Demo operator workflow. Closing a review never asserts that a banking write succeeded.
model ManualReview {
  id           String   @id @default(cuid())
  sessionId    String
  userId       String
  taskId       String?
  actionId     String?
  // Filled only while open: at most one active review per target, with durable history.
  activeKey    String?  @unique
  title        String
  reason       String
  status       String   @default("open")
  operatorId   String
  operatorName String
  notes        String?
  resolution   String? // "stop" | "retry"; never "executed"
  createdAt    DateTime @default(now())
  resolvedAt   DateTime?

  task AgentTask? @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([sessionId, status])
}

model AgentTaskNode {
  id           String    @id @default(cuid())
  taskId       String
  nodeId       String
  name         String
  kind         String
  tool         String?
  args         String? // JSON text
  condition    String? // JSON text
  dependencies String? // JSON text (array of nodeIds)
  after        String? // JSON text: order-only predecessors
  status       String    @default("pending")
  output       String? // JSON text
  compensation String? // JSON text: separate, durable rollback receipt; execution result stays intact
  error        String?
  order        Int
  startedAt    DateTime?
  endedAt      DateTime?
  // DB-level exactly-once claim for the node's side effect: the winning executor sets a unique
  // token here; a concurrent executor that cannot claim it must NOT execute the node. NULL = unclaimed.
  executionToken     String?
  executionClaimedAt DateTime?

  task AgentTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@unique([taskId, nodeId])
}

model ScheduledTask {
  id                   String   @id @default(cuid())
  userId               String
  sessionId            String?
  name                 String
  kind                 String // "REMINDER" | "PAYMENT" | "TRANSFER"
  payload              String? // JSON text
  runAt                DateTime
  status               String   @default("SCHEDULED") // "SCHEDULED" | "DONE" | "CANCELLED"
  requiresConfirmation Boolean  @default(true)
  // Replay key: `<planId>:<nodeId>` so a replayed plan node replays the existing scheduled task
  // instead of duplicating it. Unkeyed scheduled intents have no replay identity.
  idempotencyKey       String?  @unique
  createdAt            DateTime @default(now())
  dispatchTaskId       String?  @unique
  deliveredAt          DateTime?
  dispatchError        String?

  user User @relation(fields: [userId], references: [id])
  notification ScheduledNotification?

  @@index([userId])
}

// A delivered reminder is a durable user-visible fact, unique per scheduled intent.
model ScheduledNotification {
  id              String   @id @default(cuid())
  scheduledTaskId String   @unique
  userId          String
  sessionId       String
  message         String
  createdAt       DateTime @default(now())

  scheduledTask ScheduledTask @relation(fields: [scheduledTaskId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model AuditLog {
  id                   String   @id @default(cuid())
  timestamp            DateTime @default(now())
  sessionId            String
  userId               String?
  user                 User?    @relation(fields: [userId], references: [id])
  userRequest          String
  intent               String?
  toolName             String
  riskLevel            String
  confirmationRequired Boolean  @default(false)
  confirmed            Boolean  @default(false)
  mfaRequired          Boolean  @default(false)
  mfaResult            String?
  toolResult           String? // JSON text
  toolArgs             String? // JSON text — validated arguments of a SIDE-EFFECTING write
  taskId               String? // owning AgentTask (plan-driven write), null for standalone calls
  nodeId               String? // owning AgentTaskNode (plan-driven write), null for standalone calls
  status               String
  detail               String?
  // Idempotency key that makes this audit entry write-once (dedupes a repeated audit).
  dedupeKey            String?  @unique

  @@index([timestamp])
  @@index([userId])
  @@index([sessionId])
}

model SecurityEvent {
  id        String   @id @default(cuid())
  timestamp DateTime @default(now())
  sessionId String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  kind      String
  severity  String // "low" | "medium" | "high"
  message   String
  detail    String?

  @@index([timestamp])
  @@index([userId])
  @@index([sessionId])
}

model AgentSession {
  id        String   @id @default(cuid())
  userId    String
  stateJson String // serialized AgentState (JSON text)
  status    String   @default("active")
  locked    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  revision Int @default(0)
  intentJson String?
  activeRunId String?
  runLeaseToken String?
  runLeaseExpiresAt DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model PendingAction {
  id          String   @id @default(cuid())
  sessionId   String
  userId      String
  toolName    String
  argsJson    String // JSON text
  riskLevel   String
  requiresMfa Boolean  @default(false)
  status      String   @default("pending")
  summaryJson String // JSON text
  resultJson  String? // JSON text of the original execution result payload (written when the action executes)
  userRequest String? // the user's original natural-language request (audit)
  intent      String? // derived intent label (audit)
  authorizationDecisionId String?
  invocationId String?
  // Owning plan (`AgentTask.id`) + owning node (`AgentTaskNode.nodeId`), persisted AT CREATION so a
  // plan-level cancel can revoke EVERY associated operation even when the node's `output` JSON was
  // never written / was overwritten. NULL for actions created outside the planner.
  taskId      String?
  nodeId      String?
  // Persisted execution LEASE of the confirm/verify continuation applying this action side effect.
  executionLeaseOwner     String?
  executionLeaseExpiresAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  mfa MfaChallenge?

  @@index([sessionId])
  @@index([taskId])
}

model MfaChallenge {
  id          String    @id @default(cuid())
  actionId    String    @unique
  action      PendingAction @relation(fields: [actionId], references: [id], onDelete: Cascade)
  code        String
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  status      String    @default("pending") // "pending" | "verified" | "failed" | "locked"
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?
  commandDigest String?
  verifiedAt DateTime?
  consumedAt DateTime?
}

// Durable SECURITY CIRCUIT-BREAKER state. Persisted (NOT in-process) and keyed by the OWNER
// (`user:<userId>` for a real session/user, else `session:<actor>`), so a new session or a new
// process cannot bypass a lock. `failures` counts consecutive failed strong-verifications;
// reaching the threshold sets `locked` + `lockedAt`. Clearing a lock additionally requires the
// mock verification code OR an elapsed cooldown (see `security/circuit-breaker.ts`).
model CircuitBreakerState {
  key       String    @id
  userId    String?
  failures  Int       @default(0)
  locked    Boolean   @default(false)
  lockedAt  DateTime?
  updatedAt DateTime  @updatedAt

  @@index([userId])
}

// Unified EXECUTION RECEIPT / transaction-fact: the durable proof that a gated side effect with a
// given execution identity (`userId` + `key`) ALREADY COMMITTED. `requestDigest` is the canonical
// fingerprint of the ORIGINAL request, so a replay with the SAME identity returns the stored
// `resultJson` (a full result snapshot) without re-resolving anything MUTABLE (e.g. a recipient by
// name), while a replay with a DIFFERENT request is rejected explicitly. `txId` links the receipt to
// the ledger `Transaction` row it produced (when the tool writes one).
model ExecutionReceipt {
  id            String   @id
  userId        String
  key           String
  toolName      String
  requestDigest String
  resultJson    String // JSON text of the original result snapshot
  txId          String?
  // Versioned command identity and full response shared by every banking write.
  commandDigest String?
  responseJson String?
  createdAt     DateTime @default(now())

  @@unique([userId, key])
}

model AuthorizationDecision {
  id String @id @default(cuid())
  sessionId String
  userId String
  toolName String
  commandDigest String
  commandJson String
  policyVersion String
  decision String
  tier String
  reasonsJson String
  riskInputsJson String
  taskId String?
  nodeId String?
  createdAt DateTime @default(now())
  expiresAt DateTime?

  @@index([sessionId, createdAt])
  @@index([userId, createdAt])
}

model AgentRun {
  id String @id @default(cuid())
  sessionId String
  userId String
  requestId String?
  requestDigest String
  requestJson String
  status String @default("running")
  nextSequence Int @default(0)
  nextOrdinal Int @default(0)
  leaseToken String?
  leaseExpiresAt DateTime?
  startedAt DateTime @default(now())
  finishedAt DateTime?
  errorCode String?
  baseRevision Int @default(0)
  checkpointJson String?
  checkpointStage String?
  recoveryAttempts Int @default(0)
  maxRecoveryAttempts Int @default(3)
  nextRecoveryAt DateTime?
  recoveryErrorCode String?
  modelRequests ModelRequest[]
  events AgentRunEvent[]
  invocations ToolInvocation[]

  @@unique([sessionId, requestId])
  @@index([sessionId, startedAt])
  @@index([status, leaseExpiresAt])
}

model ModelRequest {
  id String @id @default(cuid())
  runId String
  ordinal Int
  requestDigest String
  inputJson String
  resultJson String?
  status String @default("started")
  attempt Int @default(1)
  maxAttempts Int @default(3)
  errorCode String?
  startedAt DateTime @default(now())
  finishedAt DateTime?
  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, ordinal])
  @@index([runId, status])
}

model AgentRunEvent {
  id String @id @default(cuid())
  runId String
  sequence Int
  channel String @default("raw")
  eventType String
  payloadJson String
  createdAt DateTime @default(now())
  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, sequence])
  @@index([runId, channel, sequence])
}

model ToolInvocation {
  id String @id @default(cuid())
  runId String
  ordinal Int
  callId String
  modelRequestId String?
  origin String @default("pi")
  parentInvocationId String?
  taskId String?
  nodeId String?
  toolName String
  argsJson String
  requestDigest String
  operationKey String
  replaySafety String
  status String @default("started")
  resultJson String?
  errorCode String?
  attempt Int @default(1)
  maxAttempts Int @default(1)
  startedAt DateTime @default(now())
  finishedAt DateTime?
  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, ordinal])
  @@unique([taskId, nodeId])
  @@index([runId, callId])
  @@index([operationKey])
  @@index([status])
}

model RiskSignal {
  id String @id @default(cuid())
  ownerKey String
  sessionId String
  kind String
  dedupeKey String? @unique
  createdAt DateTime @default(now())

  @@index([ownerKey, kind, createdAt])
}
