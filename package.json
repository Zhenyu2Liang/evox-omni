{
  "name": "ai-banking-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.19.0"
  },
  "description": "万象柜坊 EvoX Omni competition demo — Pi Agent + custom Banking Tools + Security Gateway",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:push": "tsx scripts/db-push.ts",
    "scheduler:tick": "tsx scripts/scheduler.ts",
    "agent:recover": "tsx scripts/agent-recovery.ts --once",
    "agent:worker": "tsx scripts/agent-recovery.ts",
    "weixin:login": "tsx scripts/weixin.ts login",
    "weixin:start": "tsx scripts/weixin.ts start",
    "weixin:status": "tsx scripts/weixin.ts status",
    "weixin:logout": "tsx scripts/weixin.ts logout",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "tsx scripts/db-push.ts --force-reset && tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.2.0",
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@next/env": "16.4.3",
    "@prisma/adapter-better-sqlite3": "7.10.0",
    "@prisma/client": "7.10.0",
    "decimal.js": "10.6.0",
    "next": "16.4.3",
    "pi-weixinbot": "1.0.5",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "16.4.3",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "playwright-core": "1.64.0",
    "postcss": "8.5.30",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  }
}
