# ==== 万象柜坊 EvoX Omni (demo) ====
# LLM mode: "mock" = deterministic built-in scripted model (no network, no API key needed).
#           "live" = call a real provider via @earendil-works/pi-ai using the key below.
LLM_MODE=mock

# Provider/model used only when LLM_MODE=live. Provider ids are @earendil-works/pi-ai providers:
#   openai | anthropic | google | deepseek | groq | openrouter | xai | mistral | cerebras ...
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
## Live HTTP request timeout; one transport retry and at most one pre-write planning recovery.
LLM_REQUEST_TIMEOUT_MS=30000

# Context compaction changes only the model request view; archived messages remain complete.
# Values are tokens. Effective limits are also bounded by the selected model context window.
AGENT_COMPACTION_THRESHOLD_TOKENS=60000
AGENT_COMPACTION_RESERVE_TOKENS=8192
AGENT_COMPACTION_KEEP_RECENT_TOKENS=12000
AGENT_COMPACTION_SUMMARY_TOKENS=2048

# Database (SQLite). Path is relative to the prisma/ directory.
DATABASE_URL="file:./dev.db"

# Demo identity
DEMO_USER_ID=user_liming
NEXT_PUBLIC_APP_NAME="万象柜坊 EvoX Omni"

# 微信通道：先启动银行 Web 服务，再执行 pnpm weixin:login 和 pnpm weixin:start。
# 仅允许本机银行地址；令牌与绑定保存到被 Git 忽略的目录。
WEIXIN_BANKING_URL=http://127.0.0.1:3000
WEIXIN_STATE_DIR=.local/weixinbot

# ==== API keys (only needed for LLM_MODE=live) ====
# Never commit a real key to git.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
